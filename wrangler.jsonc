{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "measurement-wallet",
  "main": "worker.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "mw.geeskit.com",
      "zone_name": "geeskit.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "measurement_wallet",
      "database_id": "a0559ef2-2a77-4516-95e1-12866e10245a"
    }
  ]
}
